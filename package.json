{
  "name": "twilio-cli-dashboard",
  "version": "2.1.0",
  "description": "Painel CLI para gerenciamento de contas Twilio entre ambientes (dev, stage, prod). Cadastro de contas, download de recursos, comparação de ambientes, migração com replace de SID e pesquisa.",
  "main": "index.js",
  "bin": {
    "twilio-dashboard": "dist/index.js",
    "tam": "dist/index.js"
  },
  "scripts": {
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "build": "node scripts/build.js",
    "dev": "nodemon --exec node ./dist/index.js",
    "start": "node ./dist/index.js",
    "lint": "eslint .",
    "format": "prettier -w ."
  },
  "keywords": [
    "twilio",
    "studio",
    "taskrouter",
    "content",
    "migration",
    "dashboard",
    "cli",
    "multi-environment"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "fs-extra": "^11.3.1",
    "twilio": "^5.9.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.1.2",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.2.0",
    "jest": "^30.1.3",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2"
  }
}
